<%
  const _currency = locals.currency || 'USD';
  const _items = Array.isArray(locals.items) ? locals.items : [];
  const _subtotal = locals.subtotal !== undefined
    ? Number(locals.subtotal)
    : _items.reduce((sum, item) => sum + Number(item.qty || 1) * Number(item.rate || 0), 0);
  const _discount = Number(locals.discount || 0);
  const _taxRate = Number(locals.taxRate || 0);
  const _taxAmount = locals.taxAmount !== undefined ? Number(locals.taxAmount) : ((_subtotal - _discount) * _taxRate) / 100;
  const _total = locals.total !== undefined ? Number(locals.total) : _subtotal - _discount + _taxAmount;
%>
<style>
  .ch-totals {
    width: 280px;
    margin-left: auto;
    margin-top: 12px;
    border-collapse: collapse;
    font-size: 9.5pt;
  }
  .ch-totals td {
    padding: 5px 8px;
    border-bottom: 1px solid var(--border);
  }
  .ch-totals tr.total-row td {
    font-size: 11pt;
    font-weight: 700;
    color: var(--primary);
    background: var(--primary-soft);
    border-top: 2px solid var(--primary);
    border-bottom: 2px solid var(--primary);
  }
</style>

<section class="meta-grid avoid-break">
  <div>
    <div class="meta-item-label">Learner Name</div>
    <div class="meta-item-value"><%= locals.learner?.name || '' %></div>
  </div>
  <div>
    <div class="meta-item-label">Learner ID</div>
    <div class="meta-item-value"><%= locals.learner?.id || '' %></div>
  </div>
  <div>
    <div class="meta-item-label">Email</div>
    <div class="meta-item-value"><%= locals.learner?.email || '' %></div>
  </div>
  <div>
    <div class="meta-item-label">Cohort / Batch</div>
    <div class="meta-item-value"><%= locals.cohort || '' %></div>
  </div>
  <div>
    <div class="meta-item-label">Payment Method</div>
    <div class="meta-item-value"><%= locals.paymentMethod || '' %></div>
  </div>
  <div>
    <div class="meta-item-label">Transaction Ref</div>
    <div class="meta-item-value"><%= locals.transactionId || '' %></div>
  </div>
</section>

<table class="doc-table">
  <thead>
    <tr>
      <th>Course / Fee Item</th>
      <th class="text-right">Qty</th>
      <th class="text-right">Fee</th>
      <th class="text-right">Amount</th>
    </tr>
  </thead>
  <tbody>
    <% _items.forEach((item) => { %>
      <% const lineTotal = item.amount !== undefined ? Number(item.amount) : Number(item.qty || 1) * Number(item.rate || 0); %>
      <tr>
        <td>
          <strong><%= item.description %></strong>
          <% if (item.notes) { %><div style="font-size: 8.2pt; color: var(--muted);"><%= item.notes %></div><% } %>
        </td>
        <td class="text-right"><%= item.qty ?? 1 %></td>
        <td class="text-right"><%= helpers.formatCurrency(item.rate, _currency) %></td>
        <td class="text-right"><%= helpers.formatCurrency(lineTotal, _currency) %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<table class="ch-totals avoid-break">
  <tr>
    <td>Subtotal</td>
    <td class="text-right"><%= helpers.formatCurrency(_subtotal, _currency) %></td>
  </tr>
  <% if (_discount > 0) { %>
    <tr>
      <td>Scholarship / Discount</td>
      <td class="text-right">-<%= helpers.formatCurrency(_discount, _currency) %></td>
    </tr>
  <% } %>
  <% if (_taxAmount > 0 || _taxRate > 0) { %>
    <tr>
      <td>Tax (<%= _taxRate %>%)</td>
      <td class="text-right"><%= helpers.formatCurrency(_taxAmount, _currency) %></td>
    </tr>
  <% } %>
  <tr class="total-row">
    <td>Total Amount</td>
    <td class="text-right"><%= helpers.formatCurrency(_total, _currency) %></td>
  </tr>
</table>

<% if (locals.notes) { %>
  <div class="callout avoid-break" style="margin-top: 22px;">
    <div class="callout-title">Notes</div>
    <p class="callout-body"><%- helpers.nl2br(locals.notes) %></p>
  </div>
<% } %>
