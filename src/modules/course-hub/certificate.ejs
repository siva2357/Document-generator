<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= locals.title || 'Certificate of Completion' %></title>
  <style>
    * {
      box-sizing: border-box;
    }

    @page {
      size: A4 landscape;
      margin: 0;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 297mm;
      height: 210mm;
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Arial, sans-serif;
      background: #ffffff;
      color: #0f172a;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .cert-page {
      width: 100%;
      height: 100%;
      padding: 14mm;
      display: flex;
      background: linear-gradient(135deg, #faf5ff 0%, #ffffff 45%, #f5f3ff 100%);
    }

    .cert-outer-border {
      flex: 1;
      border: 4px solid #6d28d9;
      padding: 5mm;
      display: flex;
      background: #ffffff;
    }

    .cert-inner-border {
      flex: 1;
      border: 1.5px solid #c4b5fd;
      padding: 14mm 20mm;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-align: center;
    }

    .cert-academy {
      font-size: 11pt;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #6d28d9;
      margin-bottom: 6px;
    }

    .cert-heading {
      font-size: 32pt;
      font-weight: 800;
      letter-spacing: 0.04em;
      color: #1e1b4b;
      margin: 0 0 6px 0;
    }

    .cert-subheading {
      font-size: 11pt;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #64748b;
      margin: 0;
    }

    .cert-recipient {
      font-size: 28pt;
      font-weight: 700;
      color: #5b21b6;
      border-bottom: 2px solid #ddd6fe;
      display: inline-block;
      padding: 4px 28px 8px 28px;
      margin: 14px auto;
    }

    .cert-description {
      font-size: 11.5pt;
      color: #334155;
      max-width: 195mm;
      margin: 0 auto;
      line-height: 1.6;
    }

    .cert-course {
      font-size: 17pt;
      font-weight: 700;
      color: #0f172a;
      margin: 10px 0 6px 0;
    }

    .cert-meta-row {
      display: flex;
      justify-content: center;
      gap: 28px;
      font-size: 9.5pt;
      color: #475569;
      margin-top: 10px;
    }

    .cert-footer {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding-top: 10px;
    }

    .cert-sig {
      width: 62mm;
      text-align: center;
    }

    .cert-sig-line {
      border-bottom: 1.5px solid #475569;
      margin-bottom: 6px;
      height: 12mm;
    }

    .cert-sig-name {
      font-weight: 700;
      font-size: 10pt;
      color: #0f172a;
    }

    .cert-sig-role {
      font-size: 8.5pt;
      color: #64748b;
    }

    .cert-seal {
      width: 24mm;
      height: 24mm;
      border-radius: 50%;
      border: 2px dashed #7c3aed;
      background: #f5f3ff;
      color: #5b21b6;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 7.5pt;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1.3;
    }
  </style>
</head>
<body>
  <div class="cert-page">
    <div class="cert-outer-border">
      <div class="cert-inner-border">
        <div>
          <div class="cert-academy"><%= locals.academyName || 'Course Hub Academy' %></div>
          <h1 class="cert-heading"><%= locals.title || 'Certificate of Completion' %></h1>
          <p class="cert-subheading">This is proudly presented to</p>
        </div>

        <div>
          <div class="cert-recipient"><%= locals.recipientName || 'Learner Name' %></div>
          <p class="cert-description">
            <%= locals.statement || 'For successfully completing all coursework, assessments, and project requirements of' %>
          </p>
          <div class="cert-course"><%= locals.courseTitle || '' %></div>
          <div class="cert-meta-row">
            <% if (locals.completionDate) { %>
              <span><strong>Completed:</strong> <%= helpers.formatDate(locals.completionDate) %></span>
            <% } %>
            <% if (locals.duration) { %>
              <span><strong>Duration:</strong> <%= locals.duration %></span>
            <% } %>
            <% if (locals.grade) { %>
              <span><strong>Grade:</strong> <%= locals.grade %></span>
            <% } %>
            <% if (locals.certificateId) { %>
              <span><strong>Credential ID:</strong> <%= locals.certificateId %></span>
            <% } %>
          </div>
        </div>

        <div class="cert-footer">
          <% const _sigs = Array.isArray(locals.signatures) ? locals.signatures : []; %>
          <div class="cert-sig">
            <% if (_sigs[0]) { %>
              <div class="cert-sig-line"></div>
              <div class="cert-sig-name"><%= _sigs[0].name %></div>
              <div class="cert-sig-role"><%= _sigs[0].role || '' %></div>
            <% } %>
          </div>

          <div class="cert-seal">Verified<br />Credential</div>

          <div class="cert-sig">
            <% if (_sigs[1]) { %>
              <div class="cert-sig-line"></div>
              <div class="cert-sig-name"><%= _sigs[1].name %></div>
              <div class="cert-sig-role"><%= _sigs[1].role || '' %></div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
